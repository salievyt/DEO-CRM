# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://deo_crm_user:deo_crm_pass@localhost:5432/deo_crm

# Redis
REDIS_URL=redis://localhost:6379/0

# S3 (MinIO)
AWS_ACCESS_KEY_ID=deo_crm_minio
AWS_SECRET_ACCESS_KEY=deo_crm_minio_pass
AWS_STORAGE_BUCKET_NAME=deo-crm-files
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1

# Firebase Cloud Messaging
FCM_CREDENTIALS_PATH=./firebase-credentials.json

# JWT
JWT_ACCESS_TOKEN_LIFETIME_HOURS=1
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@deostudio.com

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- DEO AI provider (OpenAI-compatible) ---
AI_API_URL=https://your-ai-provider.example.com/v1
AI_API_KEY=sk-your-key-here
AI_MODEL=your-model-name
